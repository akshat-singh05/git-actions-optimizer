# GHA Optimizer — Environment Configuration
# Copy this file to .env and fill in your values.

# ─── GitHub ────────────────────────────────────────────────────────
# Personal access token (repo scope) or GitHub App token
GITHUB_TOKEN=
# Webhook secret for HMAC signature validation
GITHUB_WEBHOOK_SECRET=

# ─── Database ──────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gha_optimizer
# SQLite (development fallback)
# DATABASE_URL=sqlite:///gha_optimizer.db

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── ML Models ─────────────────────────────────────────────────────
GHA_MODEL_DIR=.gha_optimizer/models

# ─── Server ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
