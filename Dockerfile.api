FROM python:3.10-slim

WORKDIR /app

# the ingestion code shells out to git (bare mirrors, diffs, tracked files)
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY setup.py .
COPY gha_optimizer ./gha_optimizer

RUN pip install -e .

CMD ["uvicorn", "gha_optimizer.server.app:app", "--host", "0.0.0.0", "--port", "8000"]
